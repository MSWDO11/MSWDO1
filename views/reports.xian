{{> head}}
<div class="flex min-h-screen bg-slate-50">
  {{> sidebar}}

  <main class="flex-1 ml-64 min-h-screen">

    <!-- Top Bar -->
    <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-10 shadow-sm">
      <div>
        <h1 class="text-lg font-bold text-slate-800">Reports &amp; Analytics</h1>
        <p class="text-xs text-slate-400 mt-0.5">Real-time overview of portal activity</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs text-slate-400 hidden sm:block" id="rptDate"></span>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-700 flex items-center justify-center text-xs font-bold text-white">{{ initials }}</div>
      </div>
    </header>

    <div class="p-8 space-y-7">

      <!-- KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Total Users</span>
            <div class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-slate-800">{{ stats.totalUsers }}</p>
          <p class="text-xs text-slate-400 mt-1">Registered accounts</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Total Cases</span>
            <div class="w-9 h-9 rounded-xl bg-violet-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-slate-800">{{ stats.totalCases }}</p>
          <p class="text-xs text-slate-400 mt-1">Applications submitted</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Pending</span>
            <div class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-slate-800">{{ stats.pendingCases }}</p>
          <p class="text-xs text-slate-400 mt-1">Awaiting review</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Approved</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-slate-800">{{ stats.approvedCases }}</p>
          <p class="text-xs text-slate-400 mt-1">Cases resolved</p>
        </div>

      </div>

      <!-- Breakdown Row -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Users by Role -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="font-bold text-slate-800">Users by Role</h3>
              <p class="text-xs text-slate-400 mt-0.5">Distribution across all account types</p>
            </div>
            <span class="text-xs font-semibold bg-blue-50 text-blue-700 px-3 py-1 rounded-full border border-blue-100">{{ stats.totalUsers }} total</span>
          </div>
          <div class="space-y-5">

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">Citizens</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.citizens }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.citizenPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.citizenPct }}%"></div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">MSWDO Staff</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.staff }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.staffPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-amber-400 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.staffPct }}%"></div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">LGU Admins</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.admins }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.adminPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-red-500 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.adminPct }}%"></div>
              </div>
            </div>

          </div>
        </div>

        <!-- Case Status -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="font-bold text-slate-800">Case Status Breakdown</h3>
              <p class="text-xs text-slate-400 mt-0.5">Current status of all submitted applications</p>
            </div>
            <span class="text-xs font-semibold bg-violet-50 text-violet-700 px-3 py-1 rounded-full border border-violet-100">{{ stats.totalCases }} total</span>
          </div>
          <div class="space-y-5">

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">Pending</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.pendingCases }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.pendingPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-amber-400 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.pendingPct }}%"></div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-500 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">Under Review</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.reviewCases }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.reviewPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-blue-500 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.reviewPct }}%"></div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">Approved</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.approvedCases }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.approvedPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.approvedPct }}%"></div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">Rejected</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-800">{{ stats.rejectedCases }}</span>
                  <span class="text-xs text-slate-400 w-8 text-right">{{ stats.rejectedPct }}%</span>
                </div>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div class="bg-red-500 h-2.5 rounded-full transition-all duration-700" style="width:{{ stats.rejectedPct }}%"></div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Summary Stats Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 text-center">
          <p class="text-2xl font-extrabold text-emerald-700">{{ stats.citizens }}</p>
          <p class="text-xs text-emerald-600 font-medium mt-1">Citizens</p>
        </div>
        <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 text-center">
          <p class="text-2xl font-extrabold text-amber-600">{{ stats.staff }}</p>
          <p class="text-xs text-amber-600 font-medium mt-1">Staff Members</p>
        </div>
        <div class="bg-red-50 border border-red-100 rounded-2xl p-4 text-center">
          <p class="text-2xl font-extrabold text-red-600">{{ stats.admins }}</p>
          <p class="text-xs text-red-600 font-medium mt-1">Administrators</p>
        </div>
        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-center">
          <p class="text-2xl font-extrabold text-blue-700">{{ stats.reviewCases }}</p>
          <p class="text-xs text-blue-600 font-medium mt-1">Under Review</p>
        </div>
      </div>

      <!-- Recent Registrations -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="font-bold text-slate-800">Recent Registrations</h3>
            <p class="text-xs text-slate-400 mt-0.5">Last 5 users who joined the portal</p>
          </div>
          <a href="/admin/users" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 hover:underline">
            View all
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        {{#if recentUsers.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">User</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Email</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Role</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Joined</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              {{#each recentUsers}}
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                      {{ this.initials }}
                    </div>
                    <span class="font-semibold text-slate-800">{{ this.fullName }}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-slate-500">{{ this.email }}</td>
                <td class="px-6 py-4">
                  {{#if (eq this.role "admin")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100"><span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>Admin</span>
                  {{else if (eq this.role "staff")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100"><span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>Staff</span>
                  {{else}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>Citizen</span>{{/if}}
                </td>
                <td class="px-6 py-4 text-slate-400 text-xs">{{ this.createdAtFormatted }}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="py-16 text-center">
          <svg class="w-12 h-12 mx-auto mb-3 text-slate-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          <p class="text-slate-400 text-sm font-medium">No users registered yet</p>
        </div>
        {{/if}}
      </div>

    </div>
  </main>
</div>
<script>document.getElementById('rptDate').textContent = new Date().toLocaleDateString('en-PH',{weekday:'short',year:'numeric',month:'short',day:'numeric'});</script>
{{> footer}}
