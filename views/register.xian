{{> head}}

  <div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-slate-100 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg">

      <!-- Card -->
      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden">

        <!-- Top Banner -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-8 py-7 text-white text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-white/20 rounded-2xl mb-3">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H4v-2a4 4 0 014-4h1m4-4a4 4 0 100-8 4 4 0 000 8z"/>
            </svg>
          </div>
          <h1 class="text-xl font-bold tracking-tight">Create Your Account</h1>
          <p class="text-blue-200 text-sm mt-1">MSWDO Online Services Portal</p>
        </div>

        <!-- Form Body -->
        <div class="px-8 py-8">
          <form method="POST" action="/register" class="space-y-5">

            <!-- Full Name -->
            <div>
              <label for="fullName" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Full Name</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
                <input type="text" id="fullName" name="fullName"
                  placeholder="e.g. Juan dela Cruz"
                  value="{{ oldInput.fullName }}"
                  class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                  required />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Email Address</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
                <input type="email" id="email" name="email"
                  placeholder="you@example.com"
                  value="{{ oldInput.email }}"
                  class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                  required />
              </div>
            </div>

            <!-- Contact Number -->
            <div>
              <label for="contactNumber" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Contact Number</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </span>
                <input type="tel" id="contactNumber" name="contactNumber"
                  placeholder="09XXXXXXXXX"
                  value="{{ oldInput.contactNumber }}"
                  pattern="^09\d{9}$"
                  title="Enter a valid PH mobile number starting with 09"
                  class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
              </div>
            </div>

            <!-- Password -->
            <div>
              <label for="regPassword" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">
                Password <span class="text-slate-400 normal-case font-normal">(min. 6 characters)</span>
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </span>
                <input type="password" id="regPassword" name="password"
                  placeholder="••••••••"
                  minlength="6"
                  class="w-full pl-10 pr-11 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                  required />
                <!-- Eye Toggle -->
                <button type="button" onclick="toggleEye('regPassword', 'eyeReg')"
                  class="absolute inset-y-0 right-3.5 flex items-center text-slate-400 hover:text-slate-600 transition">
                  <svg id="eyeReg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </button>
              </div>

              <!-- Password Strength Indicator -->
              <div class="mt-2">
                <div class="flex gap-1 mb-1">
                  <div id="s1" class="h-1 flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                  <div id="s2" class="h-1 flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                  <div id="s3" class="h-1 flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                  <div id="s4" class="h-1 flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                </div>
                <p id="strengthLabel" class="text-xs text-slate-400"></p>
              </div>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center gap-2.5">
              <input type="checkbox" id="agreeTerms"
                class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" required />
              <label for="agreeTerms" class="text-sm text-slate-600 cursor-pointer select-none">
                I agree to the <span class="text-blue-600 font-medium">terms of use</span>
              </label>
            </div>

            <!-- Hidden role -->
            <input type="hidden" name="role" value="citizen" />

            <!-- Submit -->
            <button type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-3 rounded-xl transition duration-200 text-sm shadow-lg shadow-blue-500/30 flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
              Create Account
            </button>

          </form>

          <p class="text-center text-sm text-slate-500 mt-6">
            Already have an account?
            <a href="/login" class="text-blue-600 hover:text-blue-700 font-semibold hover:underline">Sign in</a>
          </p>
        </div>
      </div>

      <p class="text-center text-xs text-slate-400 mt-5">
        By registering, you agree to the MSWDO Portal terms of use.
      </p>
      <p class="text-center mt-2">
        <a href="/" class="text-xs text-slate-400 hover:text-blue-600 transition flex items-center justify-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Back to Home
        </a>
      </p>

    </div>
  </div>

  <script>
    // ── Eye toggle ──────────────────────────────────────────────────────────
    function toggleEye(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon  = document.getElementById(iconId);
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      icon.innerHTML = isHidden
        ? `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`
        : `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
    }

    // ── Password strength meter ─────────────────────────────────────────────
    document.getElementById('regPassword').addEventListener('input', function () {
      const val = this.value;
      const bars   = [document.getElementById('s1'), document.getElementById('s2'), document.getElementById('s3'), document.getElementById('s4')];
      const label  = document.getElementById('strengthLabel');
      let score = 0;
      if (val.length >= 6)  score++;
      if (val.length >= 10) score++;
      if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      const colors = ['bg-red-400', 'bg-orange-400', 'bg-yellow-400', 'bg-emerald-500'];
      const labels = ['Weak', 'Fair', 'Good', 'Strong'];
      const textColors = ['text-red-500', 'text-orange-500', 'text-yellow-500', 'text-emerald-600'];

      bars.forEach((b, i) => {
        b.className = `h-1 flex-1 rounded-full transition-all duration-300 ${i < score ? colors[score - 1] : 'bg-slate-200'}`;
      });

      label.textContent = val.length === 0 ? '' : labels[score - 1] || 'Weak';
      label.className   = `text-xs transition-all ${val.length === 0 ? 'text-slate-400' : textColors[score - 1] || 'text-red-500'}`;
    });
  </script>

{{> footer}}
