<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — MSWDO Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">

  <!-- Flash Messages -->
  {{#if success_msg}}
  <div id="flash-success" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-green-100 border border-green-400 text-green-800 px-6 py-3 rounded-lg shadow-md text-sm flex items-center gap-2">
    <span>✅</span> <span>{{ success_msg }}</span>
    <button onclick="document.getElementById('flash-success').remove()" class="ml-4 font-bold text-green-600 hover:text-green-900">&times;</button>
  </div>
  {{/if}}
  {{#if error_msg}}
  <div id="flash-error" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-red-100 border border-red-400 text-red-800 px-6 py-3 rounded-lg shadow-md text-sm flex items-center gap-2">
    <span>❌</span> <span>{{ error_msg }}</span>
    <button onclick="document.getElementById('flash-error').remove()" class="ml-4 font-bold text-red-600 hover:text-red-900">&times;</button>
  </div>
  {{/if}}
