<aside class="w-64 bg-slate-900 text-white flex flex-col fixed top-0 left-0 h-full z-20 shadow-2xl">

  <!-- Brand -->
  <div class="px-5 py-5 border-b border-slate-700/60">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-lg">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>
      <div>
        <p class="font-bold text-sm text-white leading-tight">MSWDO Portal</p>
        <p class="text-xs text-slate-400">
          {{#if (eq user.role "admin")}}Admin Panel{{else if (eq user.role "staff")}}Staff Panel{{else}}Citizen Portal{{/if}}
        </p>
      </div>
    </div>
  </div>

  <!-- User Info -->
  <div class="px-5 py-4 border-b border-slate-700/60">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-violet-500 to-purple-700 flex items-center justify-center text-sm font-bold text-white flex-shrink-0">
        {{ initials }}
      </div>
      <div class="min-w-0">
        <p class="font-semibold text-sm text-white truncate">{{ user.fullName }}</p>
        <p class="text-xs text-slate-400 truncate">{{ user.email }}</p>
      </div>
    </div>
    {{#if (eq user.role "admin")}}
      <span class="mt-2 inline-flex items-center gap-1 bg-red-500/20 text-red-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-red-500/30">
        <span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span> LGU Admin
      </span>
    {{else if (eq user.role "staff")}}
      <span class="mt-2 inline-flex items-center gap-1 bg-yellow-500/20 text-yellow-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-yellow-500/30">
        <span class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span> MSWDO Staff
      </span>
    {{else}}
      <span class="mt-2 inline-flex items-center gap-1 bg-green-500/20 text-green-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-green-500/30">
        <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span> Citizen
      </span>
    {{/if}}
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">

    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest px-3 pb-2 pt-1">Main</p>

    <a href="/dashboard"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'dashboard')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span>Dashboard</span>
    </a>

    <!-- Citizen links -->
    {{#if (eq user.role "citizen")}}
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest px-3 pb-2 pt-3">My Services</p>
    <a href="/my-cases"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'mycases')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>My Applications</span>
    </a>
    <a href="/apply"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'apply')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      <span>New Application</span>
    </a>
    {{/if}}

    <!-- Staff links -->
    {{#if (eq user.role "staff")}}
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest px-3 pb-2 pt-3">Case Management</p>
    <a href="/staff/cases"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'staffcases')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
      <span>Manage Cases</span>
    </a>
    <a href="/staff/beneficiaries"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'beneficiaries')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
      <span>Beneficiaries</span>
    </a>
    {{/if}}

    <!-- Admin links -->
    {{#if (eq user.role "admin")}}
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest px-3 pb-2 pt-3">Administration</p>
    <a href="/admin/reports"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'reports')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      <span>Reports &amp; Analytics</span>
    </a>
    <a href="/admin/users"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'users')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
      <span>All Users</span>
    </a>
    <a href="/admin/cases"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'cases')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
      <span>All Cases</span>
    </a>
    <a href="/admin/settings"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-150 {{#if (eq activePage 'settings')}}bg-blue-600 text-white font-semibold shadow-lg shadow-blue-600/30{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <span>Settings</span>
    </a>
    {{/if}}

  </nav>

  <!-- Logout -->
  <div class="px-3 py-4 border-t border-slate-700/60">
    <a href="/logout"
      class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-400 hover:bg-red-500/10 hover:text-red-400 transition-all duration-150">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      <span>Sign Out</span>
    </a>
  </div>

</aside>
