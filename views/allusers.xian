{{> head}}
<div class="flex min-h-screen bg-slate-50">
  {{> sidebar}}

  <main class="flex-1 ml-64 min-h-screen">

    <!-- Top Bar -->
    <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-10 shadow-sm">
      <div>
        <h1 class="text-lg font-bold text-slate-800">All Users</h1>
        <p class="text-xs text-slate-400 mt-0.5">Manage all registered portal accounts</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-100">{{ totalUsers }} accounts</span>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-700 flex items-center justify-center text-xs font-bold text-white">{{ initials }}</div>
      </div>
    </header>

    <div class="p-8 space-y-6">

      <!-- Role Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/admin/users" class="bg-white rounded-2xl border {{#if (eq activeFilter 'all')}}border-slate-800 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 flex items-center gap-3 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          </div>
          <div>
            <p class="text-xl font-extrabold text-slate-800">{{ totalUsers }}</p>
            <p class="text-xs text-slate-500">All Users</p>
          </div>
        </a>
        <a href="/admin/users?role=citizen" class="bg-white rounded-2xl border {{#if (eq activeFilter 'citizen')}}border-emerald-500 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 flex items-center gap-3 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <p class="text-xl font-extrabold text-emerald-700">{{ citizenCount }}</p>
            <p class="text-xs text-slate-500">Citizens</p>
          </div>
        </a>
        <a href="/admin/users?role=staff" class="bg-white rounded-2xl border {{#if (eq activeFilter 'staff')}}border-amber-500 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 flex items-center gap-3 transition-all">
          <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <p class="text-xl font-extrabold text-amber-600">{{ staffCount }}</p>
            <p class="text-xs text-slate-500">Staff</p>
          </div>
        </a>
        <a href="/admin/users?role=admin" class="bg-white rounded-2xl border {{#if (eq activeFilter 'admin')}}border-red-500 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 flex items-center gap-3 transition-all">
          <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div>
            <p class="text-xl font-extrabold text-red-600">{{ adminCount }}</p>
            <p class="text-xs text-slate-500">Admins</p>
          </div>
        </a>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-800">
            {{#if (eq activeFilter 'all')}}All Registered Users
            {{else if (eq activeFilter 'citizen')}}Citizens
            {{else if (eq activeFilter 'staff')}}MSWDO Staff
            {{else}}LGU Administrators{{/if}}
          </h3>
          <span class="text-xs text-slate-400">{{ totalUsers }} result{{#if (eq totalUsers 1)}}{{else}}s{{/if}}</span>
        </div>
        {{#if users.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-10">#</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">User</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Contact</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Role</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Joined</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {{#each users}}
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-6 py-4 text-slate-400 text-xs font-medium">{{ this.index }}</td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0 shadow-sm">
                      {{ this.initials }}
                    </div>
                    <div>
                      <p class="font-semibold text-slate-800 leading-tight">{{ this.fullName }}</p>
                      <p class="text-xs text-slate-400 mt-0.5">{{ this.email }}</p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  {{#if this.contactNumber}}
                  <span class="text-slate-600 text-sm">{{ this.contactNumber }}</span>
                  {{else}}
                  <span class="text-slate-300 text-xs italic">Not provided</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4">
                  {{#if (eq this.role "admin")}}<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100"><span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>Admin</span>
                  {{else if (eq this.role "staff")}}<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100"><span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>Staff</span>
                  {{else}}<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>Citizen</span>{{/if}}
                </td>
                <td class="px-6 py-4">
                  <p class="text-slate-600 text-xs font-medium">{{ this.createdAtFormatted }}</p>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="py-20 text-center">
          <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          </div>
          <p class="text-slate-500 font-semibold text-sm">No users found</p>
          <p class="text-slate-400 text-xs mt-1">Try selecting a different filter above</p>
        </div>
        {{/if}}
      </div>

    </div>
  </main>
</div>
{{> footer}}
