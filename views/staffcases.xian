{{> head}}
<div class="flex min-h-screen bg-slate-50">
  {{> sidebar}}

  <main class="flex-1 md:ml-64 min-h-screen">

    <!-- Top Bar -->
    <header class="bg-white border-b border-slate-200 px-4 md:px-8 py-4 flex items-center justify-between sticky top-0 z-10 shadow-sm">
      <button onclick="openSidebar()" class="md:hidden mr-3 p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 transition flex-shrink-0 order-first"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <!-- Hamburger — mobile only -->
      <button onclick="openSidebar()" class="md:hidden mr-3 p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 transition flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div>
        <h1 class="text-lg font-bold text-slate-800">Manage Cases</h1>
        <p class="text-xs text-slate-400 mt-0.5">Review and update assistance applications</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="bg-violet-50 text-violet-700 text-xs font-bold px-3 py-1.5 rounded-full border border-violet-100">{{ totalCases }} cases</span>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-700 flex items-center justify-center text-xs font-bold text-white">{{ initials }}</div>
      </div>
    </header>

    <div class="p-4 md:p-8 space-y-6">

      <!-- Status Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/staff/cases?status=pending" class="bg-white rounded-2xl border {{#if (eq activeFilter 'pending')}}border-amber-400 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 text-center transition-all">
          <p class="text-2xl font-extrabold text-amber-600">{{ pendingCount }}</p>
          <p class="text-xs text-slate-500 mt-0.5">Pending</p>
        </a>
        <a href="/staff/cases?status=review" class="bg-white rounded-2xl border {{#if (eq activeFilter 'review')}}border-blue-400 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 text-center transition-all">
          <p class="text-2xl font-extrabold text-blue-600">{{ reviewCount }}</p>
          <p class="text-xs text-slate-500 mt-0.5">Under Review</p>
        </a>
        <a href="/staff/cases?status=approved" class="bg-white rounded-2xl border {{#if (eq activeFilter 'approved')}}border-emerald-400 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 text-center transition-all">
          <p class="text-2xl font-extrabold text-emerald-600">{{ approvedCount }}</p>
          <p class="text-xs text-slate-500 mt-0.5">Approved</p>
        </a>
        <a href="/staff/cases?status=rejected" class="bg-white rounded-2xl border {{#if (eq activeFilter 'rejected')}}border-red-400 shadow-md{{else}}border-slate-200 hover:border-slate-300 shadow-sm{{/if}} p-4 text-center transition-all">
          <p class="text-2xl font-extrabold text-red-600">{{ rejectedCount }}</p>
          <p class="text-xs text-slate-500 mt-0.5">Rejected</p>
        </a>
      </div>

      <!-- Filter Pills -->
      <div class="flex gap-2 flex-wrap">
        <a href="/staff/cases" class="text-xs px-4 py-2 rounded-full font-semibold border transition {{#if (eq activeFilter 'all')}}bg-slate-800 text-white border-slate-800{{else}}bg-white text-slate-600 border-slate-200 hover:border-slate-400{{/if}}">All Cases</a>
        <a href="/staff/cases?status=pending" class="text-xs px-4 py-2 rounded-full font-semibold border transition {{#if (eq activeFilter 'pending')}}bg-amber-500 text-white border-amber-500{{else}}bg-white text-slate-600 border-slate-200 hover:border-slate-400{{/if}}">Pending</a>
        <a href="/staff/cases?status=review" class="text-xs px-4 py-2 rounded-full font-semibold border transition {{#if (eq activeFilter 'review')}}bg-blue-600 text-white border-blue-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-slate-400{{/if}}">Under Review</a>
        <a href="/staff/cases?status=approved" class="text-xs px-4 py-2 rounded-full font-semibold border transition {{#if (eq activeFilter 'approved')}}bg-emerald-600 text-white border-emerald-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-slate-400{{/if}}">Approved</a>
        <a href="/staff/cases?status=rejected" class="text-xs px-4 py-2 rounded-full font-semibold border transition {{#if (eq activeFilter 'rejected')}}bg-red-600 text-white border-red-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-slate-400{{/if}}">Rejected</a>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-800">
            {{#if (eq activeFilter 'all')}}All Cases
            {{else if (eq activeFilter 'pending')}}Pending Cases
            {{else if (eq activeFilter 'review')}}Under Review
            {{else if (eq activeFilter 'approved')}}Approved Cases
            {{else}}Rejected Cases{{/if}}
          </h3>
          <span class="text-xs text-slate-400">{{ totalCases }} result{{#if (eq totalCases 1)}}{{else}}s{{/if}}</span>
        </div>

        {{#if cases.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">#</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Applicant</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Type</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Description</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Date</th>
                <th class="px-4 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {{#each cases}}
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-4 py-4 text-slate-400 text-xs">{{ this.index }}</td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                      {{ this.applicantInitials }}
                    </div>
                    <div>
                      <p class="font-semibold text-slate-800 text-xs leading-tight">{{ this.applicantName }}</p>
                      <p class="text-slate-400 text-xs">{{ this.applicantEmail }}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4 text-slate-600 text-xs font-medium">{{ this.assistanceType }}</td>
                <td class="px-4 py-4 text-slate-500 text-xs max-w-xs">
                  <p class="truncate">{{ this.description }}</p>
                </td>
                <td class="px-4 py-4">
                  {{#if (eq this.status "pending")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100"><span class="w-1.5 h-1.5 bg-amber-400 rounded-full animate-pulse"></span>Pending</span>
                  {{else if (eq this.status "review")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100"><span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></span>Under Review</span>
                  {{else if (eq this.status "approved")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>Approved</span>
                  {{else if (eq this.status "rejected")}}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100"><span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>Rejected</span>
                  {{else}}<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">{{ this.status }}</span>{{/if}}
                </td>
                <td class="px-4 py-4 text-slate-400 text-xs">{{ this.createdAtFormatted }}</td>
                <td class="px-4 py-4">
                  <form method="POST" action="/staff/cases/{{ this.id }}/status" class="space-y-1.5">
                    <select name="status"
                      class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 w-full">
                      <option value="pending"  {{#if (eq this.status "pending")}}selected{{/if}}>Pending</option>
                      <option value="review"   {{#if (eq this.status "review")}}selected{{/if}}>Under Review</option>
                      <option value="approved" {{#if (eq this.status "approved")}}selected{{/if}}>Approved</option>
                      <option value="rejected" {{#if (eq this.status "rejected")}}selected{{/if}}>Rejected</option>
                    </select>
                    <input type="text" name="notes" placeholder="Add note (optional)"
                      class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 bg-white text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-400 w-full" />
                    <button type="submit"
                      class="w-full text-xs bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg font-semibold transition">
                      Save
                    </button>
                  </form>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="py-20 text-center">
          <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <p class="text-slate-500 font-semibold text-sm">No cases found</p>
          <p class="text-slate-400 text-xs mt-1">Cases will appear here once citizens submit applications.</p>
        </div>
        {{/if}}
      </div>

    </div>
  </main>
</div>
{{> footer}}



