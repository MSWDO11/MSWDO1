{{> head}}

  <!-- Navbar -->
  <nav class="bg-blue-700 text-white px-6 py-4 flex items-center justify-between shadow">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
        <span class="text-blue-700 font-bold text-sm">M</span>
      </div>
      <span class="font-bold text-lg tracking-wide">MSWDO Portal</span>
    </div>
    <div class="flex items-center gap-4 text-sm">
      <a href="/login"    class="hover:underline">Login</a>
      <a href="/register" class="bg-white text-blue-700 font-semibold px-4 py-1.5 rounded-lg hover:bg-gray-100 transition">Register</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="bg-blue-600 text-white py-20 px-6 text-center">
    <h1 class="text-4xl font-extrabold mb-4 leading-tight">
      Municipal Social Welfare &amp; Development Office
    </h1>
    <p class="text-lg text-blue-100 max-w-2xl mx-auto mb-8">
      A digital portal connecting citizens to social welfare services — apply for assistance,
      upload documents, and track your application status online.
    </p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/register"
        class="bg-white text-blue-700 font-semibold px-6 py-3 rounded-xl hover:bg-blue-50 transition shadow">
        Get Started
      </a>
      <a href="/login"
        class="border border-white text-white font-semibold px-6 py-3 rounded-xl hover:bg-blue-500 transition">
        Sign In
      </a>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 px-6 max-w-5xl mx-auto">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-10">What You Can Do</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div class="bg-white rounded-xl shadow p-6 text-center">
        <div class="text-4xl mb-3">📋</div>
        <h3 class="font-semibold text-gray-800 text-lg mb-2">Apply for Assistance</h3>
        <p class="text-gray-500 text-sm">Submit applications for social welfare programs and financial aid directly online.</p>
      </div>

      <div class="bg-white rounded-xl shadow p-6 text-center">
        <div class="text-4xl mb-3">📁</div>
        <h3 class="font-semibold text-gray-800 text-lg mb-2">Upload Documents</h3>
        <p class="text-gray-500 text-sm">Securely upload required documents from home. No more long queues at the office.</p>
      </div>

      <div class="bg-white rounded-xl shadow p-6 text-center">
        <div class="text-4xl mb-3">🔔</div>
        <h3 class="font-semibold text-gray-800 text-lg mb-2">Track Your Application</h3>
        <p class="text-gray-500 text-sm">Get real-time updates on your application status directly on your dashboard.</p>
      </div>

    </div>
  </section>

  <!-- Who Is This For -->
  <section class="bg-gray-50 py-12 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Who Is This Portal For?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl border p-5">
          <p class="text-3xl mb-2">🧑‍🤝‍🧑</p>
          <h3 class="font-semibold text-gray-800">Citizens &amp; Beneficiaries</h3>
          <p class="text-gray-500 text-sm mt-1">Apply for programs and monitor your case status.</p>
        </div>
        <div class="bg-white rounded-xl border p-5">
          <p class="text-3xl mb-2">👩‍💼</p>
          <h3 class="font-semibold text-gray-800">MSWDO Staff</h3>
          <p class="text-gray-500 text-sm mt-1">Manage applications, update case records, and coordinate services.</p>
        </div>
        <div class="bg-white rounded-xl border p-5">
          <p class="text-3xl mb-2">🏛️</p>
          <h3 class="font-semibold text-gray-800">LGU Administrators</h3>
          <p class="text-gray-500 text-sm mt-1">View real-time reports, analytics, and oversee all operations.</p>
        </div>
      </div>
    </div>
  </section>

{{> footer}}
