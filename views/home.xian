{{> head}}

  <!-- Navbar -->
  <nav class="bg-white border-b border-slate-100 shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-blue-700 flex items-center justify-center shadow-sm">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
        </div>
        <div>
          <p class="font-bold text-slate-800 text-sm leading-tight">MSWDO Portal</p>
          <p class="text-xs text-slate-400 leading-tight">Bansud, Oriental Mindoro</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/login" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition">Login</a>
        <a href="/register" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition shadow-sm shadow-blue-200">
          Get Started
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-700 via-blue-600 to-blue-500 text-white">
    <div class="max-w-6xl mx-auto px-6 py-24 flex flex-col lg:flex-row items-center gap-12">
      <div class="flex-1 text-center lg:text-left">
        <span class="inline-flex items-center gap-1.5 bg-white/15 text-white text-xs font-semibold px-3 py-1.5 rounded-full mb-5 border border-white/20">
          <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
          Bansud, Oriental Mindoro — Official Portal
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-5">
          Municipal Social Welfare<br class="hidden sm:block"/> &amp; Development Office
        </h1>
        <p class="text-blue-100 text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          A digital gateway to social welfare services in Bansud, Oriental Mindoro. Apply for assistance, track your applications, and connect with MSWDO staff — all online.
        </p>
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a href="/register"
            class="bg-white text-blue-700 font-bold px-6 py-3 rounded-xl hover:bg-blue-50 transition shadow-lg shadow-blue-800/20 flex items-center gap-2 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            Create Free Account
          </a>
          <a href="/login"
            class="border border-white/40 text-white font-semibold px-6 py-3 rounded-xl hover:bg-white/10 transition text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14"/></svg>
            Sign In
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="flex-shrink-0 grid grid-cols-2 gap-4 w-full max-w-xs">
        <div class="bg-white/15 border border-white/20 rounded-2xl p-5 text-center backdrop-blur-sm">
          <p class="text-3xl font-extrabold">24/7</p>
          <p class="text-blue-100 text-xs mt-1">Online Access</p>
        </div>
        <div class="bg-white/15 border border-white/20 rounded-2xl p-5 text-center backdrop-blur-sm">
          <p class="text-3xl font-extrabold">10+</p>
          <p class="text-blue-100 text-xs mt-1">Assistance Types</p>
        </div>
        <div class="bg-white/15 border border-white/20 rounded-2xl p-5 text-center backdrop-blur-sm">
          <p class="text-3xl font-extrabold">3–5</p>
          <p class="text-blue-100 text-xs mt-1">Days Processing</p>
        </div>
        <div class="bg-white/15 border border-white/20 rounded-2xl p-5 text-center backdrop-blur-sm">
          <p class="text-3xl font-extrabold">Free</p>
          <p class="text-blue-100 text-xs mt-1">No Fees</p>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="w-full overflow-hidden leading-none">
      <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-12 fill-slate-50">
        <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z"/>
      </svg>
    </div>
  </section>

  <!-- Services Section -->
  <section class="bg-slate-50 py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Our Services</span>
        <h2 class="text-3xl font-extrabold text-slate-800 mt-2">What We Offer</h2>
        <p class="text-slate-500 mt-3 max-w-lg mx-auto text-sm">The Municipality of Bansud MSWDO provides a range of social protection programs for every constituent.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-100 transition">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">Financial Assistance</h3>
          <p class="text-slate-500 text-sm">Emergency financial aid for indigent families and individuals in crisis situations.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-red-100 transition">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">Medical Assistance</h3>
          <p class="text-slate-500 text-sm">Support for hospitalization, medicine, and medical procedures for eligible residents.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-purple-100 transition">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">Educational Assistance</h3>
          <p class="text-slate-500 text-sm">Scholarships and school supply support for deserving students in Bansud.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-amber-100 transition">
            <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">Senior Citizen Programs</h3>
          <p class="text-slate-500 text-sm">Benefits and services exclusively for senior citizens of Bansud, Oriental Mindoro.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-emerald-100 transition">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">Livelihood Assistance</h3>
          <p class="text-slate-500 text-sm">Livelihood programs and starter kits to help families achieve financial stability.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow group">
          <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-slate-200 transition">
            <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-bold text-slate-800 mb-1">PWD &amp; Solo Parent</h3>
          <p class="text-slate-500 text-sm">Dedicated programs for persons with disabilities and solo parent constituents.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Process</span>
        <h2 class="text-3xl font-extrabold text-slate-800 mt-2">How It Works</h2>
        <p class="text-slate-500 mt-3 text-sm">Three simple steps to access social welfare services online.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-200">
            <span class="text-white font-extrabold text-xl">1</span>
          </div>
          <h3 class="font-bold text-slate-800 mb-2">Create an Account</h3>
          <p class="text-slate-500 text-sm">Register for free using your email. No need to visit the office.</p>
        </div>
        <div class="text-center relative">
          <div class="hidden md:block absolute top-7 -left-4 w-8 border-t-2 border-dashed border-slate-200"></div>
          <div class="hidden md:block absolute top-7 -right-4 w-8 border-t-2 border-dashed border-slate-200"></div>
          <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-200">
            <span class="text-white font-extrabold text-xl">2</span>
          </div>
          <h3 class="font-bold text-slate-800 mb-2">Submit Application</h3>
          <p class="text-slate-500 text-sm">Fill out the assistance form and describe your situation clearly.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-200">
            <span class="text-white font-extrabold text-xl">3</span>
          </div>
          <h3 class="font-bold text-slate-800 mb-2">Track Your Status</h3>
          <p class="text-slate-500 text-sm">Monitor real-time updates on your application from your dashboard.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Is This For -->
  <section class="bg-slate-50 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Roles</span>
        <h2 class="text-3xl font-extrabold text-slate-800 mt-2">Who Is This Portal For?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl border border-emerald-100 shadow-sm p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <span class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full border border-emerald-100 mb-3">Citizens</span>
          <h3 class="font-bold text-slate-800 mb-2">Residents of Bansud</h3>
          <p class="text-slate-500 text-sm">Apply for programs, upload documents, and monitor your application status online.</p>
        </div>
        <div class="bg-white rounded-2xl border border-amber-100 shadow-sm p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-amber-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <span class="inline-block bg-amber-50 text-amber-700 text-xs font-bold px-3 py-1 rounded-full border border-amber-100 mb-3">MSWDO Staff</span>
          <h3 class="font-bold text-slate-800 mb-2">Social Welfare Workers</h3>
          <p class="text-slate-500 text-sm">Manage and process applications, update case status, and coordinate services efficiently.</p>
        </div>
        <div class="bg-white rounded-2xl border border-red-100 shadow-sm p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <span class="inline-block bg-red-50 text-red-700 text-xs font-bold px-3 py-1 rounded-full border border-red-100 mb-3">LGU Administrators</span>
          <h3 class="font-bold text-slate-800 mb-2">Municipal Officials</h3>
          <p class="text-slate-500 text-sm">View real-time analytics, generate reports, and oversee all welfare operations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location / Contact -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Location</span>
        <h2 class="text-3xl font-extrabold text-slate-800 mt-2">Find Us</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="font-bold text-slate-800 text-sm">Address</p>
              <p class="text-slate-500 text-sm mt-0.5">Municipal Hall, Bansud<br/>Oriental Mindoro, Philippines</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-bold text-slate-800 text-sm">Office Hours</p>
              <p class="text-slate-500 text-sm mt-0.5">Monday – Friday<br/>8:00 AM – 5:00 PM</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
            </div>
            <div>
              <p class="font-bold text-slate-800 text-sm">Online Portal</p>
              <p class="text-slate-500 text-sm mt-0.5">Available 24/7<br/>Apply anytime, anywhere.</p>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-56 flex items-center justify-center">
          <div class="text-center text-slate-400 px-6">
            <svg class="w-10 h-10 mx-auto mb-2 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
            <p class="text-sm font-medium">Bansud, Oriental Mindoro</p>
            <p class="text-xs mt-1">Municipality of Bansud</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-gradient-to-r from-blue-700 to-blue-600 py-16 px-6 text-center text-white">
    <h2 class="text-3xl font-extrabold mb-3">Ready to get started?</h2>
    <p class="text-blue-100 text-sm mb-7 max-w-md mx-auto">Create your free account today and access all social welfare services of Bansud, Oriental Mindoro online.</p>
    <a href="/register"
      class="inline-flex items-center gap-2 bg-white text-blue-700 font-bold px-7 py-3.5 rounded-xl hover:bg-blue-50 transition shadow-lg shadow-blue-800/20 text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      Create Free Account
    </a>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-8 px-6 text-center">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="w-6 h-6 rounded-lg bg-blue-600 flex items-center justify-center">
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      </div>
      <p class="text-white font-bold text-sm">MSWDO Portal</p>
    </div>
    <p class="text-xs">Municipal Social Welfare &amp; Development Office — Bansud, Oriental Mindoro</p>
    <p class="text-xs mt-1">&copy; 2026 Municipality of Bansud. All rights reserved.</p>
  </footer>

{{> footer}}
