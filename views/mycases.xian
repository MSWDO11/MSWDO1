{{> head}}
<div class="flex min-h-screen bg-slate-50">
  {{> sidebar}}

  <main class="flex-1 ml-64 min-h-screen">

    <!-- Top Bar -->
    <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-10 shadow-sm">
      <div>
        <h1 class="text-lg font-bold text-slate-800">My Applications</h1>
        <p class="text-xs text-slate-400 mt-0.5">Track the status of all your submitted requests</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/apply"
          class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2 rounded-xl transition shadow-sm flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          New Application
        </a>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-green-600 flex items-center justify-center text-xs font-bold text-white">{{ initials }}</div>
      </div>
    </header>

    <div class="p-8 space-y-6">

      <!-- Status Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center hover:shadow-md transition-shadow">
          <p class="text-2xl font-extrabold text-slate-800">{{ totalCases }}</p>
          <p class="text-xs text-slate-500 mt-0.5">Total Submitted</p>
        </div>
        <div class="bg-amber-50 rounded-2xl border border-amber-100 p-4 text-center">
          <p class="text-2xl font-extrabold text-amber-600">{{ pending }}</p>
          <p class="text-xs text-amber-600 mt-0.5 font-medium">Pending</p>
        </div>
        <div class="bg-blue-50 rounded-2xl border border-blue-100 p-4 text-center">
          <p class="text-2xl font-extrabold text-blue-600">{{ review }}</p>
          <p class="text-xs text-blue-600 mt-0.5 font-medium">Under Review</p>
        </div>
        <div class="bg-emerald-50 rounded-2xl border border-emerald-100 p-4 text-center">
          <p class="text-2xl font-extrabold text-emerald-600">{{ approved }}</p>
          <p class="text-xs text-emerald-600 mt-0.5 font-medium">Approved</p>
        </div>
      </div>

      <!-- Cases Table / Cards -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-800">Application History</h3>
          <span class="text-xs text-slate-400">{{ totalCases }} submission{{#if (eq totalCases 1)}}{{else}}s{{/if}}</span>
        </div>

        {{#if cases.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">#</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Type of Assistance</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Description</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Submitted</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {{#each cases}}
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-6 py-4 text-slate-400 text-xs font-medium">{{ this.index }}</td>
                <td class="px-6 py-4">
                  <span class="font-semibold text-slate-800 text-sm">{{ this.assistanceType }}</span>
                </td>
                <td class="px-6 py-4 text-slate-500 max-w-xs">
                  <p class="truncate text-xs">{{ this.description }}</p>
                </td>
                <td class="px-6 py-4">
                  {{#if (eq this.status "pending")}}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">
                      <span class="w-1.5 h-1.5 bg-amber-400 rounded-full animate-pulse"></span>Pending
                    </span>
                  {{else if (eq this.status "review")}}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                      <span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></span>Under Review
                    </span>
                  {{else if (eq this.status "approved")}}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                      <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>Approved
                    </span>
                  {{else if (eq this.status "rejected")}}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100">
                      <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>Rejected
                    </span>
                  {{else}}
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">{{ this.status }}</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 text-slate-400 text-xs">{{ this.createdAtFormatted }}</td>
                <td class="px-6 py-4 text-slate-500 text-xs max-w-xs">
                  {{#if this.notes}}
                    <p class="truncate italic">{{ this.notes }}</p>
                  {{else}}
                    <span class="text-slate-300">—</span>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="py-20 text-center">
          <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="text-slate-500 font-semibold text-sm">No applications yet</p>
          <p class="text-slate-400 text-xs mt-1 mb-4">You haven't submitted any assistance requests.</p>
          <a href="/apply"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Submit Your First Application
          </a>
        </div>
        {{/if}}
      </div>

      <!-- Help Box -->
      <div class="bg-slate-800 rounded-2xl p-6 flex items-start gap-4">
        <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
          <p class="font-semibold text-white text-sm">Need help?</p>
          <p class="text-slate-400 text-xs mt-1">For questions about your application, visit the MSWDO office or call your local government unit. Processing time is typically 3–5 business days.</p>
        </div>
      </div>

    </div>
  </main>
</div>
{{> footer}}
